    },
    {
      "id": "linux-x64",
      "package": "caliper-docgen-linux-x64-gnu",
      "url": "https://registry.npmjs.org/caliper-docgen-linux-x64-gnu/-/caliper-docgen-linux-x64-gnu-{version}.tgz",
